// Property Rental Management System — Prisma schema
//
// ⭐ ยึดตาม **ระบบเดิม** (`--recover-redesign-v2/db/prisma/schema.prisma`) เป็นหลัก
//    เพื่อให้ UI ที่พอร์ตมาใช้ได้โดยไม่ต้องแก้ enum/field — ที่ spec เขียนต่างไว้
//    ให้ยึดของเดิม (เจ้าของสั่ง "ทำตามระบบได้เลย ขาดก็เติมตาม UI")
//
// สิ่งที่ต่างจากระบบเดิมโดยตั้งใจ (2 ข้อ):
//   1. auth — ระบบเดิมเขียน JWT เอง (User + RefreshToken + Role/Permission ใน DB)
//      ที่นี่ใช้ Supabase Auth ตาม spec: `Profile` แทน `User` (id = auth.users.id)
//      และตารางสิทธิ์อยู่ใน lib/policies/permissions.config.ts (code) ไม่ใช่ DB
//   2. running number — เพิ่ม `CodeSequence` + ฟังก์ชัน next_code_seq() ให้ atomic
//      (ระบบเดิมออกเลขที่ service layer)
//
// สิ่งที่ Prisma เขียนไม่ได้ (RLS/exclusion constraint/trigger) อยู่ใน prisma/sql/policies.sql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler 6543 (runtime)
  directUrl = env("DIRECT_URL") // direct 5432 (migrate เท่านั้น)
}

// ─────────────────────────────── enums ───────────────────────────────
// ค่าทั้งหมดตรงกับระบบเดิมเป๊ะ — UI/i18n catalog อ้างค่าพวกนี้เป็น key

enum Role {
  super_admin // เจ้าของ
  property_manager // ผู้จัดการ
  sales_agent // เซล

  @@map("role")
}

enum UserStatus {
  active
  suspended
  invited

  @@map("user_status")
}

enum Language {
  en // ระบบเดิม default = อังกฤษ (ไทยเป็นตัวเลือก)
  th

  @@map("language")
}

enum PropertyType {
  condo
  house
  townhome
  apartment

  @@map("property_type")
}

/// draft →(ขอเผยแพร่ ครบ 7/7)→ pending_review →(เจ้าของอนุมัติ)→ available →(ทำสัญญา)→ rented
enum PropertyStatus {
  draft
  pending_review
  available
  rented

  @@map("property_status")
}

enum Furnished {
  fully
  partial
  unfurnished

  @@map("furnished")
}

enum MediaType {
  image
  video
  floor_plan

  @@map("media_type")
}

enum PropertyRequestStatus {
  pending // เซลส่ง รอผู้ดูแลทรัพย์ตรวจ
  needs_info // ตีกลับให้แก้ (soft) — เซลแก้แล้วส่งใหม่
  converted // สร้างเป็นประกาศ (ร่าง) แล้ว
  rejected

  @@map("property_request_status")
}

enum LeadSource {
  public_web
  walk_in
  phone
  referral

  @@map("lead_source")
}

enum LeadStatus {
  new
  working
  closed

  @@map("lead_status")
}

/// 3 สถานะ: รอพบ → พบแล้ว / ยกเลิก
enum AppointmentStatus {
  upcoming
  done
  cancelled

  @@map("appointment_status")
}

/// 3 สถานะ: ร่าง → มีผล → สิ้นสุด ("ใกล้ครบกำหนด" = คำนวณจาก endDate ไม่ใช่สถานะ)
enum ContractStatus {
  draft
  active
  ended

  @@map("contract_status")
}

enum DocType {
  title_deed
  id_card
  house_registration
  lease
  receipt
  power_of_attorney
  property_photo
  other

  @@map("doc_type")
}

enum DocStatus {
  uploaded
  verified
  active
  archived

  @@map("doc_status")
}

enum EntityType {
  property
  property_request
  owner
  customer
  lead
  contract
  appointment
  company
  /// เพิ่มจากระบบเดิม — จำเป็นสำหรับ audit ของ auth/user management
  /// (ระบบเดิมเขียน auth เอง จึงไม่ได้ผูก entity นี้ไว้)
  user

  @@map("entity_type")
}

enum NotificationChannel {
  line
  email
  in_app

  @@map("notification_channel")
}

enum NotificationCategory {
  lead
  appointment
  property
  owner
  contract
  system

  @@map("notification_category")
}

enum NotificationStatus {
  queued
  delivered
  read
  failed

  @@map("notification_status")
}

enum CommunityCategory {
  looking_room
  looking_condo
  for_rent
  looking_tenant
  buy_sell

  @@map("community_category")
}

enum CommunityStatus {
  pending
  published
  archived
  rejected

  @@map("community_status")
}

// ───────────────────────── องค์กร / ผู้ใช้ ─────────────────────────

/// สาขา — ระบบเดิมรองรับหลายสาขาไว้ (ตอนนี้ใช้สาขาเดียว แต่คง field ไว้ให้ scope ทำงาน)
model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profiles     Profile[]
  properties   Property[]
  owners       Owner[]
  customers    Customer[]
  leads        Lead[]
  appointments Appointment[]
  contracts    Contract[]
  documents    Document[]

  @@map("branches")
}

model Team {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(150)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  members   Profile[]

  @@map("teams")
}

/// 1:1 กับ auth.users ของ Supabase — `id` = auth.users.id
/// (ระบบเดิมชื่อ `User` + มี passwordHash/RefreshToken เอง — ที่นี่ Supabase Auth ถือแทน)
model Profile {
  id       String     @id @db.Uuid
  email    String     @unique @db.VarChar(150)
  fullName String     @map("full_name") @db.VarChar(150)
  phone    String?    @db.VarChar(20)
  role     Role
  status   UserStatus @default(active)
  language Language   @default(en)
  teamId   String?    @map("team_id") @db.Uuid
  branchId String?    @map("branch_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  sessions           UserSession[]
  assignedProperties Property[]              @relation("PropertyAssignee")
  sourcedProperties  Property[]              @relation("PropertySourcer")
  propertyStatusLogs PropertyStatusHistory[]
  submittedRequests  PropertyRequest[]       @relation("RequestSubmitter")
  reviewedRequests   PropertyRequest[]       @relation("RequestReviewer")
  assignedLeads      Lead[]                  @relation("LeadAssignee")
  appointments       Appointment[]           @relation("AppointmentAgent")
  contracts          Contract[]              @relation("ContractAgent")
  verifiedDocuments  Document[]              @relation("DocumentVerifier")
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  communityPosts     CommunityPost[]         @relation("CommunityAuthor")
  auditLogs          AuditLog[]
  activityLogs       ActivityLog[]

  @@index([role])
  @@index([branchId])
  @@map("profiles")
}

/// mirror ของ session ที่ Supabase ออกให้ — เพื่อหน้า "อุปกรณ์ที่เข้าใช้งาน" + ถอนสิทธิ์
model UserSession {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  supabaseSid String?   @unique @map("supabase_sid")
  device      String?   @db.VarChar(60)
  browser     String?   @db.VarChar(60)
  ip          String?   @db.VarChar(60)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

// ───────────────────────── ทรัพย์ / เจ้าของทรัพย์ ─────────────────────────

model Owner {
  id       String  @id @default(uuid(7)) @db.Uuid
  fullName String  @map("full_name") @db.VarChar(150)
  phone    String? @db.VarChar(20)
  email    String? @db.VarChar(150)
  /// AES-256-GCM ciphertext — decrypt เฉพาะ super_admin ผ่าน GET /owners/:id/idcard (log audit ทุกครั้ง)
  idCardNo String? @map("id_card_no") @db.Text
  /// 4 ตัวท้าย เก็บแยกเพื่อ mask ••••1234 ได้โดยไม่ต้อง decrypt
  idCardLast4 String? @map("id_card_last4") @db.VarChar(4)
  address  String? @db.Text
  note     String? @db.Text
  branchId String? @map("branch_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  properties Property[]
  contracts  Contract[]

  @@index([phone])
  @@index([branchId])
  @@map("owners")
}

model Property {
  id           String         @id @default(uuid(7)) @db.Uuid
  code         String         @unique @db.VarChar(30) // CD/HS/TH/AP-ปี-เลข
  ownerId      String         @map("owner_id") @db.Uuid
  assignedToId String?        @map("assigned_to") @db.Uuid
  /// เซลผู้หาทรัพย์ (มาจาก property request) — ใช้คิดเครดิต/ค่าคอม
  sourcedById  String?        @map("sourced_by") @db.Uuid
  propertyType PropertyType   @map("property_type")
  status       PropertyStatus @default(draft)

  titleTh       String  @map("title_th") @db.VarChar(200)
  titleEn       String? @map("title_en") @db.VarChar(200)
  descriptionTh String? @map("description_th") @db.Text
  descriptionEn String? @map("description_en") @db.Text

  address     String?  @db.Text
  province    String?  @db.VarChar(100)
  district    String?  @db.VarChar(100)
  subdistrict String?  @db.VarChar(100)
  projectName String?  @map("project_name") @db.VarChar(150)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)

  monthlyRent   Decimal    @map("monthly_rent") @db.Decimal(12, 2)
  depositMonths Int?       @map("deposit_months") @db.SmallInt
  bedrooms      Int?       @db.SmallInt
  bathrooms     Int?       @db.SmallInt
  areaSqm       Decimal?   @map("area_sqm") @db.Decimal(8, 2)
  floor         String?    @db.VarChar(20)
  furnished     Furnished?
  /// เก็บเป็น array ของ amenity code (master data) — ระบบเดิมใช้ JSONB ไม่ใช่ตาราง m2m
  amenities     Json?      @db.JsonB

  isFeatured Boolean @default(false) @map("is_featured")
  viewCount  Int     @default(0) @map("view_count")

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  /// เนื้อหาถูกแก้หลังอนุมัติล่าสุด (แก้ตอน rented) — rented→available ที่ dirty ต้องเด้งไปตรวจใหม่
  /// เคลียร์ตอน approve
  contentDirty Boolean @default(false) @map("content_dirty")
  branchId     String? @map("branch_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  owner         Owner                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  assignedTo    Profile?                @relation("PropertyAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  sourcedBy     Profile?                @relation("PropertySourcer", fields: [sourcedById], references: [id], onDelete: SetNull)
  branch        Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fromRequests  PropertyRequest[]       @relation("PropertyFromRequest")
  media         PropertyMedia[]
  statusHistory PropertyStatusHistory[]
  leadInterests LeadInterest[]
  appointments  Appointment[]
  contracts     Contract[]

  @@index([status])
  @@index([propertyType])
  @@index([ownerId])
  @@index([assignedToId])
  @@index([branchId])
  @@index([province, district])
  @@index([monthlyRent])
  @@map("properties")
}

model PropertyMedia {
  id         String    @id @default(uuid(7)) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  storageKey String    @map("storage_key") @db.Text
  mediaType  MediaType @map("media_type")
  sortOrder  Int       @default(0) @map("sort_order") @db.SmallInt
  isCover    Boolean   @default(false) @map("is_cover")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("property_media")
}

model PropertyStatusHistory {
  id         String          @id @default(uuid(7)) @db.Uuid
  propertyId String          @map("property_id") @db.Uuid
  fromStatus PropertyStatus? @map("from_status")
  toStatus   PropertyStatus  @map("to_status")
  actorId    String?         @map("actor_id") @db.Uuid
  reason     String?         @db.Text
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  actor    Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@map("property_status_history")
}

/// เซลเสนอทรัพย์เข้ามา → ผจก./เจ้าของตรวจ → convert เป็น Property (ร่าง)
model PropertyRequest {
  id           String                @id @default(uuid(7)) @db.Uuid
  status       PropertyRequestStatus @default(pending)
  propertyType PropertyType          @map("property_type")

  province    String? @db.VarChar(100)
  district    String? @db.VarChar(100)
  projectName String? @map("project_name") @db.VarChar(150)

  expectedRent Decimal? @map("expected_rent") @db.Decimal(12, 2)
  bedrooms     Int?     @db.SmallInt
  bathrooms    Int?     @db.SmallInt
  areaSqm      Decimal? @map("area_sqm") @db.Decimal(8, 2)
  note         String?  @db.Text

  ownerName    String  @map("owner_name") @db.VarChar(150)
  ownerPhone   String  @map("owner_phone") @db.VarChar(20)
  /// เจ้าของทรัพย์ยินยอมให้ติดต่อ/ลงประกาศ
  ownerConsent Boolean @default(false) @map("owner_consent")

  reviewNote     String?   @map("review_note") @db.Text
  submittedById  String    @map("submitted_by") @db.Uuid
  reviewedById   String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  convertedToId  String?   @map("converted_to_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  submittedBy Profile   @relation("RequestSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  Profile?  @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  convertedTo Property? @relation("PropertyFromRequest", fields: [convertedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([submittedById])
  @@map("property_requests")
}

// ───────────────────────── ผู้สนใจ / ลูกค้า / นัดหมาย ─────────────────────────

model Customer {
  id          String  @id @default(uuid(7)) @db.Uuid
  fullName    String  @map("full_name") @db.VarChar(150)
  phone       String? @db.VarChar(20)
  email       String? @db.VarChar(150)
  idCardNo    String? @map("id_card_no") @db.Text
  idCardLast4 String? @map("id_card_last4") @db.VarChar(4)
  address     String? @db.Text
  branchId    String? @map("branch_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  leads     Lead[]
  contracts Contract[]

  @@index([phone])
  @@map("customers")
}

/// ระบบเดิมเรียก Lead — โหมดไทยใช้คำว่า "ผู้สนใจ" (glossary ล็อกไว้)
model Lead {
  id              String     @id @default(uuid(7)) @db.Uuid
  code            String     @unique @db.VarChar(30) // LD-ปี-เลข
  fullName        String     @map("full_name") @db.VarChar(150)
  phone           String     @db.VarChar(20)
  email           String?    @db.VarChar(150)
  source          LeadSource @default(public_web)
  status          LeadStatus @default(new)
  assignedToId    String?    @map("assigned_to") @db.Uuid
  customerId      String?    @map("customer_id") @db.Uuid
  lostReason      String?    @map("lost_reason") @db.Text
  message         String?    @db.Text
  preferredViewAt DateTime?  @map("preferred_view_at") @db.Timestamptz(6)

  /// PDPA — เก็บเวลาและเวอร์ชันคำยินยอมตอนกรอกฟอร์มสาธารณะ
  consentAt      DateTime? @map("consent_at") @db.Timestamptz(6)
  consentVersion String?   @map("consent_version") @db.VarChar(20)
  branchId       String?   @map("branch_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  assignedTo   Profile?       @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  interests    LeadInterest[]
  appointments Appointment[]

  @@index([status, createdAt])
  @@index([assignedToId])
  @@map("leads")
}

model LeadInterest {
  leadId     String   @map("lead_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([leadId, propertyId])
  @@map("lead_interests")
}

model Appointment {
  id           String            @id @default(uuid(7)) @db.Uuid
  code         String            @unique @db.VarChar(30) // APT-ปี-เลข
  leadId       String?           @map("lead_id") @db.Uuid
  propertyId   String?           @map("property_id") @db.Uuid
  agentId      String            @map("agent_id") @db.Uuid
  status       AppointmentStatus @default(upcoming)
  title        String?           @db.Text
  scheduledAt  DateTime          @map("scheduled_at") @db.Timestamptz(6)
  durationMin  Int               @default(30) @map("duration_min") @db.SmallInt
  /// = scheduled_at + durationMin — เขียนจาก app, DB มี CHECK ยืนยันความสอดคล้อง
  /// exclusion constraint ใช้คู่ (scheduled_at, ends_at) กันเวลาซ้อนของ agent เดียวกัน
  endsAt       DateTime          @map("ends_at") @db.Timestamptz(6)
  location     String?           @db.Text
  note         String?           @db.Text
  cancelReason String?           @map("cancel_reason") @db.Text
  completedAt  DateTime?         @map("completed_at") @db.Timestamptz(6)
  branchId     String?           @map("branch_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  agent    Profile   @relation("AppointmentAgent", fields: [agentId], references: [id], onDelete: Restrict)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([agentId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("appointments")
}

// ───────────────────────── สัญญา ─────────────────────────

model Contract {
  id               String         @id @default(uuid(7)) @db.Uuid
  code             String         @unique @db.VarChar(30) // CT-ปี-เลข
  propertyId       String         @map("property_id") @db.Uuid
  ownerId          String         @map("owner_id") @db.Uuid
  customerId       String         @map("customer_id") @db.Uuid
  agentId          String         @map("agent_id") @db.Uuid
  status           ContractStatus @default(draft)
  startDate        DateTime?      @map("start_date") @db.Date
  endDate          DateTime?      @map("end_date") @db.Date
  monthlyRent      Decimal        @map("monthly_rent") @db.Decimal(12, 2)
  depositAmount    Decimal?       @map("deposit_amount") @db.Decimal(12, 2)
  commissionAmount Decimal?       @map("commission_amount") @db.Decimal(12, 2)
  signedAt         DateTime?      @map("signed_at") @db.Timestamptz(6)
  signedById       String?        @map("signed_by") @db.Uuid
  receiptIssuedAt  DateTime?      @map("receipt_issued_at") @db.Timestamptz(6)
  renewedFromId    String?        @map("renewed_from_id") @db.Uuid
  terminatedReason String?        @map("terminated_reason") @db.Text
  branchId         String?        @map("branch_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  owner       Owner          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agent       Profile        @relation("ContractAgent", fields: [agentId], references: [id], onDelete: Restrict)
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  renewedFrom Contract?      @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals    Contract[]     @relation("ContractRenewal")
  terms       ContractTerm[]

  @@index([status, endDate])
  @@index([propertyId])
  @@index([customerId])
  @@map("contracts")
}

model ContractTerm {
  id         String   @id @default(uuid(7)) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  label      String   @db.VarChar(200)
  value      String   @db.Text
  sortOrder  Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, sortOrder])
  @@map("contract_terms")
}

// ───────────────────────── เอกสาร ─────────────────────────

model Document {
  id           String    @id @default(uuid(7)) @db.Uuid
  documentType DocType   @map("document_type")
  name         String    @db.VarChar(200)
  status       DocStatus @default(uploaded)
  verifiedById String?   @map("verified_by") @db.Uuid
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  branchId     String?   @map("branch_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  verifiedBy Profile?          @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  branch     Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  versions   DocumentVersion[]
  links      DocumentLink[]

  @@index([documentType, status])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid(7)) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  storageKey   String   @map("storage_key") @db.Text
  versionNo    Int      @map("version_no") @db.SmallInt
  fileSize     Int      @map("file_size")
  fileType     String   @map("file_type") @db.VarChar(100)
  checksum     String   @db.VarChar(64) // sha256
  uploadedById String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
  @@map("document_versions")
}

/// เอกสารต้องมี link ≥ 1 เสมอ (ห้ามมีเอกสารลอย) — บังคับด้วย deferred constraint trigger
model DocumentLink {
  documentId String     @map("document_id") @db.Uuid
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("document_links")
}

// ───────────────────────── แจ้งเตือน ─────────────────────────

/// ระบบเดิมเก็บทั้งข้อความสำเร็จรูป (fallback สำหรับ LINE/email) และ key+params (ให้ UI แปลเอง)
model Notification {
  id       String               @id @default(uuid(7)) @db.Uuid
  userId   String               @map("user_id") @db.Uuid
  category NotificationCategory
  channel  NotificationChannel  @default(in_app)
  status   NotificationStatus   @default(queued)

  title String @db.VarChar(200)
  body  String @db.Text
  /// i18n — FE แปล t(titleKey, params) เอง · คง title/body ไว้เป็น fallback + ส่ง LINE/email
  titleKey String? @map("title_key") @db.VarChar(120)
  bodyKey  String? @map("body_key") @db.VarChar(120)
  params   Json?   @db.JsonB

  entityType EntityType? @map("entity_type")
  entityId   String?     @map("entity_id") @db.Uuid

  sentAt     DateTime? @map("sent_at") @db.Timestamptz(6)
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  failReason String?   @map("fail_reason") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, channel])
  @@map("notifications")
}

model NotificationPreference {
  userId   String               @map("user_id") @db.Uuid
  category NotificationCategory
  channel  NotificationChannel
  enabled  Boolean              @default(true)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, channel])
  @@map("notification_preferences")
}

// ───────────────────────── บันทึก / ประวัติ ─────────────────────────

/// insert-only — trigger ใน policies.sql บล็อก UPDATE/DELETE/TRUNCATE ที่ระดับ DB
model AuditLog {
  id         String     @id @default(uuid(7)) @db.Uuid
  actorId    String?    @map("actor_id") @db.Uuid
  actorRole  Role?      @map("actor_role")
  action     String     @db.VarChar(80)
  entityType EntityType @map("entity_type")
  entityId   String?    @map("entity_id") @db.VarChar(60)
  oldValue   Json?      @map("old_value") @db.JsonB
  newValue   Json?      @map("new_value") @db.JsonB
  ip         String?    @db.VarChar(60)
  device     String?    @db.Text
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// timeline เชิงธุรกิจที่ผู้ใช้เห็นได้ (ต่างจาก audit log ที่เป็นหลักฐาน)
/// `i18nKey`/`i18nParams` ให้ UI แปลเอง — `summary` คงไว้เป็น fallback + ส่ง LINE/email
model ActivityLog {
  id         String     @id @default(uuid(7)) @db.Uuid
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id") @db.Uuid
  action     String     @db.VarChar(80)
  actorId    String?    @map("actor_id") @db.Uuid
  summary    String     @db.Text
  i18nKey    String?    @map("i18n_key") @db.VarChar(120)
  i18nParams Json?      @map("i18n_params") @db.JsonB
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@map("activity_logs")
}

// ───────────────────────── กระดานชุมชน ─────────────────────────

/// โมดูลของระบบเดิม (ไม่มีใน spec) — ผู้ดูแล = super_admin / property_manager
model CommunityPost {
  id       String            @id @default(uuid(7)) @db.Uuid
  category CommunityCategory
  status   CommunityStatus   @default(pending)
  title    String            @db.VarChar(200)
  body     String            @db.Text
  contact  String?           @db.VarChar(150)
  authorId String?           @map("author_id") @db.Uuid

  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectReason String?   @map("reject_reason") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  author Profile? @relation("CommunityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("community_posts")
}

// ───────────────────────── ตั้งค่า / master data ─────────────────────────

model Setting {
  key       String   @id @db.VarChar(100)
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("settings")
}

/// จังหวัด/สิ่งอำนวยความสะดวก ฯลฯ — มี label 2 ภาษาในตัว (UI เลือกตาม locale)
model MasterData {
  id        String   @id @default(uuid(7)) @db.Uuid
  kind      String   @db.VarChar(40) // 'province' | 'amenity' | …
  code      String   @db.VarChar(60)
  labelTh   String   @map("label_th") @db.VarChar(150)
  labelEn   String   @map("label_en") @db.VarChar(150)
  group     String?  @db.VarChar(60) // amenity: common/security/transport/pet/other
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([kind, code])
  @@index([kind, isActive, sortOrder])
  @@map("master_data")
}

/// running number ต่อปี (CD-2026-0001, LD-2026-0001, …) — ออกผ่าน next_code_seq() ใน policies.sql
model CodeSequence {
  scope     String @db.VarChar(10)
  year      Int    @db.SmallInt
  lastValue Int    @default(0) @map("last_value")

  @@id([scope, year])
  @@map("code_sequences")
}
